<IfModule mod_security2.c>
    # Ver comentário equivalente em public/.htaccess — mesmo fix, caso o
    # document root do cPanel aponte pra raiz do projeto em vez de /public.
    <If "%{REQUEST_URI} =~ m#^/(ml|google-ads)/callback#">
        SecRuleEngine Off
    </If>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>